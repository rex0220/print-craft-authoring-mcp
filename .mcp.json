{
  "mcpServers": {
    "print-craft": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/server/index.cjs",
        "--surface",
        "claude-code",
        "--roots",
        "${user_config.workspaceRoots}"
      ],
      "env": {
        "PCRAFT_PLUGIN_ZIP": "${user_config.pluginZip}",
        "KINTONE_BASE_URL": "${user_config.kintoneBaseUrl}",
        "KINTONE_API_TOKEN": "${user_config.kintoneApiToken}",
        "KINTONE_USERNAME": "${user_config.kintoneUsername}",
        "KINTONE_PASSWORD": "${user_config.kintonePassword}"
      }
    }
  }
}
